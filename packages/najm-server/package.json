{
  "name": "@monsef-nbj/najm-server",
  "version": "1.0.0-rc.1",
  "description": "Najm's executable SSR development, production build, and preview server entry modules.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monsef-Noubadji/Najm.git",
    "directory": "packages/najm-server"
  },
  "homepage": "https://github.com/Monsef-Noubadji/Najm#readme",
  "bugs": {
    "url": "https://github.com/Monsef-Noubadji/Najm/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "ssr",
    "islands",
    "najm"
  ]
}
