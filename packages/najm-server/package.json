{
  "name": "najm-server",
  "version": "0.3.0-dev",
  "description": "Najm's SSR dev server and `najm dev` CLI entry point. Routing lives in najm-router.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "files": ["dist", "README.md"],
  "bin": {
    "najm": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "najm": "workspace:*",
    "najm-compiler": "workspace:*",
    "najm-router": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "keywords": ["ssr", "islands", "najm"]
}
