{
  "name": "@monsef-nbj/najm-compiler",
  "version": "1.1.0-rc.0",
  "description": "The Najm compiler: .najm functional components → SSR string builders + hydration claim-walks. Includes the Vite plugin.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monsef-Noubadji/Najm.git",
    "directory": "packages/najm-compiler"
  },
  "homepage": "https://github.com/Monsef-Noubadji/Najm#readme",
  "bugs": {
    "url": "https://github.com/Monsef-Noubadji/Najm/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api.d.ts",
      "default": "./dist/plugin-api.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "keywords": [
    "compiler",
    "vite-plugin",
    "najm"
  ]
}
