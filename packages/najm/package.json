{
  "name": "@monsef-nbj/najm",
  "version": "1.1.0-rc.0",
  "description": "Najm's reactivity core, component runtime, lifecycle, and hydration engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monsef-Noubadji/Najm.git",
    "directory": "packages/najm"
  },
  "homepage": "https://github.com/Monsef-Noubadji/Najm#readme",
  "bugs": {
    "url": "https://github.com/Monsef-Noubadji/Najm/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "najm": "./dist/cli.js",
    "create-najm-app": "./dist/create-app.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@monsef-nbj/najm-compiler": "1.1.0-rc.0",
    "@monsef-nbj/najm-router": "1.1.0-rc.0",
    "@monsef-nbj/najm-server": "1.1.0-rc.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "signals",
    "reactivity",
    "islands",
    "ssr",
    "hydration",
    "najm"
  ]
}
