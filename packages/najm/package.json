{
  "name": "@monsef-nbj/najm",
  "version": "0.3.0-beta.0",
  "description": "Najm's reactivity core, component runtime, lifecycle, and hydration engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monsef-Noubadji/Najm.git",
    "directory": "packages/najm"
  },
  "homepage": "https://github.com/Monsef-Noubadji/Najm#readme",
  "bugs": {
    "url": "https://github.com/Monsef-Noubadji/Najm/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
