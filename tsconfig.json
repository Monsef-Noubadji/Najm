{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "najm/core": ["./runtime/index.ts"]
    }
  },
  "include": ["compiler", "runtime", "router", "server", "tests", "src", "language-server", "vscode/src", "cli", "benchmarks"]
}
